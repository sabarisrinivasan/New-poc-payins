# Keep this API module server-only: VITE_ variables are browser-exposable
VITE_PUBLIC_PAYIN_URL=https://api.example.com
VITE_PAYIN_ORG_ID=10050
VITE_PAYIN_CLIENT_KEY=your-client-key
VITE_PAYIN_CLIENT_SECRET=your-client-secret
VITE_PAYIN_DEBUG_LOGS=false

# Merchant return URLs must be absolute URLs
VITE_PUBLIC_SUCCESS_URL=https://merchant.example.com/callback?status=SUCCESS
VITE_PUBLIC_FAILURE_URL=https://merchant.example.com/callback?status=FAILED
VITE_PUBLIC_CANCEL_URL=https://merchant.example.com/callback?status=CANCELLED
