# Server-only payment order configuration
PAYIN_API_URL=https://api.example.com
PAYIN_ORG_ID=10050
PAYIN_CLIENT_KEY=your-client-key
PAYIN_CLIENT_SECRET=your-client-secret
PAYIN_DEBUG_LOGS=false

# Merchant return URLs must be absolute URLs
PAYIN_SUCCESS_URL=http://localhost:5173/callback?status=success
PAYIN_FAILURE_URL=http://localhost:5173/callback?status=failure
PAYIN_CANCEL_URL=http://localhost:5173/
